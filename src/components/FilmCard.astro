---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { film: string; title: string; eyebrow?: string; line?: string }
import D from '../data/film-durations.json';
const { film, title, eyebrow, line } = Astro.props;
const dur = (D as Record<string, string>)[film] ?? '';
const imgs = import.meta.glob<{ default: ImageMetadata }>('../assets/films/*.jpg', { eager: true });
const img = imgs[`../assets/films/${film}.jpg`]?.default;
---
<button class="film" type="button" data-film={film} data-title={title}>
  <span class="thumb">
    {img && <Image src={img} alt="" widths={[360, 640, 960]} sizes="(max-width: 620px) 100vw, (max-width: 1000px) 50vw, 25vw" loading="lazy" />}
    <span class="play" aria-hidden="true"><svg width="15" height="15" viewBox="0 0 24 24" fill="#fff"><path d="M7 4v16l13-8z"/></svg></span>
    <span class="dur"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M11 5 6 9H2v6h4l5 4V5z"/><path d="M15.5 8.5a5 5 0 0 1 0 7"/></svg> {dur}</span>
  </span>
  <span class="fb">{eyebrow && <span class="eyebrow">{eyebrow}</span>}<b>{title}</b>{line && <span class="ln">{line}</span>}</span>
</button>
<style>
  .film { background: #fff; border: 1px solid var(--line); border-radius: var(--r); overflow: hidden; padding: 0; text-align: left; font: inherit; color: inherit; cursor: pointer; transition: box-shadow .2s, transform .2s; width: 100%; }
  .film:hover { box-shadow: var(--shadow); transform: translateY(-2px); }
  .thumb { position: relative; display: block; aspect-ratio: 16 / 9; background: var(--sage-tint); }
  .thumb :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .play { position: absolute; left: 12px; bottom: 12px; width: 40px; height: 40px; border-radius: 50%; background: var(--forest); display: grid; place-items: center; }
  .dur { position: absolute; right: 10px; bottom: 12px; display: inline-flex; gap: 5px; align-items: center; font: 500 .72rem var(--mono); background: rgba(252, 250, 245, .94); padding: 3px 8px; border-radius: 100px; color: var(--ink); }
  .fb { display: grid; gap: 2px; padding: 14px 18px 18px; }
  .fb b { font-family: var(--serif); font-size: 1.15rem; }
  .ln { font-size: .92rem; color: var(--ink-soft); }
</style>
