---
import Logo from './Logo.astro';
import { SITE } from '../data/site';
import { lp, t, type Lang } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const T = t(lang);
const year = new Date().getFullYear();
const L = (p: string) => lp(lang, p);
---
<footer class="foot">
  <div class="wrap cols">
    <div>
      <Logo light />
      <p>{T.foot.about}</p>
    </div>
    <div>
      <h2>{T.foot.explore}</h2>
      <a href={L('/solutions/')}>{T.nav.solutions}</a><a href={L('/services/')}>{T.nav.services}</a><a href={L('/tools/')}>{T.nav.tools}</a><a href={L('/projects/')}>{T.nav.projects}</a><a href={L('/about/')}>{T.nav.about}</a><a href={L('/insights/')}>{T.nav.insights}</a>
    </div>
    <div>
      <h2>{T.foot.foryou}</h2>
      {Object.entries(T.audiences).map(([k, a]) => <a href={L(`/for/${k}/`)}>{a.name}</a>)}
    </div>
    <div>
      <h2>{T.foot.contact}</h2>
      <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
      <a href={`tel:${SITE.phoneHref}`}>{SITE.phone}</a>
      <span>{SITE.address[0]}<br />{SITE.address[1]}</span>
      <a href={L('/contact/')} class="fbtn">{T.btn.write} →</a>
    </div>
  </div>
  <div class="wrap bot"><span>© {year} {SITE.name}</span><span><a href={L('/privacy/')}>{T.foot.privacy}</a> · {T.foot.tagline}</span></div>
</footer>
<style>
  .foot { background: var(--forest); color: #cfe0d3; padding: 64px 0 28px; }
  .cols { display: grid; grid-template-columns: 1.6fr 1fr 1.1fr 1.4fr; gap: 32px; }
  .cols p { margin-top: 14px; font-size: .95rem; max-width: 42ch; }
  h2 { font: 500 .75rem var(--mono); letter-spacing: .16em; text-transform: uppercase; color: var(--gold-soft); margin-bottom: 12px; }
  .cols a, .cols span { display: block; color: #e7efe9; text-decoration: none; font-size: .95rem; padding: 3px 0; }
  .cols a:hover { color: #fff; text-decoration: underline; }
  .cols .fbtn { margin-top: 10px; font-weight: 700; color: var(--gold-soft); }
  .bot { display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; border-top: 1px solid rgba(255,255,255,.15); margin-top: 40px; padding-top: 20px; font-size: .88rem; }
  .bot a { color: #e7efe9; }
  @media (max-width: 900px) { .cols { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .cols { grid-template-columns: 1fr; } }
</style>
