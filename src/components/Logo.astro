---
const { light = false } = Astro.props;
---
<span class="logo" class:list={{ light }}>
  <span class="mark" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/><path d="M2 21c0-3 1.85-5.36 5.08-6"/></svg></span>
  <span>NbS<span class="plus">+</span>C</span>
</span>
<style>
  .logo { display: inline-flex; align-items: center; gap: 10px; font: 700 1.3rem var(--serif); color: var(--forest); }
  .light { color: #fff; }
  .mark { width: 34px; height: 34px; border-radius: 50%; background: var(--leaf); display: grid; place-items: center; }
  .plus { color: var(--gold); }
  .light .plus { color: var(--gold-soft); }
</style>
