---
import Logo from './Logo.astro';
import { bookHref } from '../data/site';
import { LANGS, basePath, lp, t, type Lang } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const T = t(lang);
const base = basePath(Astro.url.pathname);
const NAV: [string, string][] = [
  ['/solutions/', T.nav.solutions], ['/services/', T.nav.services], ['/tools/', T.nav.tools],
  ['/projects/', T.nav.projects], ['/about/', T.nav.about], ['/insights/', T.nav.insights],
];
const on = (h: string) => base.startsWith(h);
const Langs = LANGS.map((l) => ({ l, href: lp(l, base), cur: l === lang }));
---
<header class="top">
  <div class="wrap bar">
    <a href={lp(lang, '/')} aria-label="NbS+C home" class="home"><Logo /></a>
    <nav aria-label="Main" class="desk">
      {NAV.map(([h, n]) => <a href={lp(lang, h)} aria-current={on(h) ? 'page' : undefined}>{n}</a>)}
    </nav>
    <div class="right">
      <nav class="langs desk-l" aria-label={T.nav.language}>
        {Langs.map(({ l, href, cur }) => <a href={href} hreflang={l} lang={l} aria-current={cur ? 'true' : undefined}>{l.toUpperCase()}</a>)}
      </nav>
      <a href={lp(lang, '/contact/')} class="btn btn-ghost btn-small desk" aria-current={on('/contact/') ? 'page' : undefined}>{T.nav.contact}</a>
      <a href={bookHref(lang)} class="btn btn-primary btn-small book" data-track="book-call">{T.btn.book}</a>
      <details class="mob">
        <summary aria-label={T.nav.menu}><span></span><span></span><span></span></summary>
        <div class="panel">
          <nav aria-label={T.nav.menu}>
            {NAV.map(([h, n]) => <a href={lp(lang, h)} aria-current={on(h) ? 'page' : undefined}>{n}</a>)}
            <a href={lp(lang, '/contact/')}>{T.nav.contact}</a>
          </nav>
          <nav class="langs" aria-label={T.nav.language}>
            {Langs.map(({ l, href, cur }) => <a href={href} hreflang={l} lang={l} aria-current={cur ? 'true' : undefined}>{l.toUpperCase()}</a>)}
          </nav>
        </div>
      </details>
    </div>
  </div>
</header>
<script>
  // Close the mobile menu after choosing a link or tapping outside it.
  document.querySelectorAll<HTMLDetailsElement>('details.mob').forEach((d) => {
    d.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) d.open = false; });
    document.addEventListener('click', (e) => { if (d.open && !d.contains(e.target as Node)) d.open = false; });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') d.open = false; });
  });
</script>
<style>
  .top { position: sticky; top: 0; z-index: 50; background: rgba(247, 244, 237, .94); backdrop-filter: blur(10px); border-bottom: 1px solid var(--line); }
  .bar { display: flex; align-items: center; gap: 20px; height: 68px; }
  .home { text-decoration: none; flex: none; }
  nav.desk { display: flex; gap: 2px; margin-left: 8px; }
  nav a { color: var(--ink-soft); font-weight: 600; font-size: .95rem; text-decoration: none; padding: 8px 12px; border-radius: 100px; white-space: nowrap; }
  nav a:hover, nav a[aria-current] { color: var(--forest); background: var(--sage-tint); }
  .right { margin-left: auto; display: flex; align-items: center; gap: 10px; }
  .langs { display: flex; gap: 2px; border: 1px solid var(--line); border-radius: 100px; padding: 3px; background: var(--paper); }
  .langs a { font: 600 .78rem var(--mono); padding: 6px 9px; letter-spacing: .04em; }
  .langs a[aria-current] { background: var(--forest); color: #fff; }
  .mob { display: none; position: relative; }
  .mob summary { list-style: none; cursor: pointer; padding: 10px 6px; }
  .mob summary::-webkit-details-marker { display: none; }
  .mob summary span { display: block; width: 22px; height: 2px; background: var(--forest); margin: 4px 0; border-radius: 2px; transition: transform .2s, opacity .2s; }
  .mob[open] summary span:nth-child(1) { transform: translateY(6px) rotate(45deg); }
  .mob[open] summary span:nth-child(2) { opacity: 0; }
  .mob[open] summary span:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }
  .panel { position: absolute; right: 0; top: 52px; background: var(--paper); border: 1px solid var(--line); border-radius: var(--r); padding: 10px; min-width: 240px; box-shadow: var(--shadow); display: grid; gap: 10px; }
  .panel nav:first-child { display: flex; flex-direction: column; }
  .panel nav:first-child a { padding: 12px 14px; font-size: 1.05rem; }
  .panel .langs { justify-content: space-between; }
  .panel .langs a { flex: 1; text-align: center; }
  @media (max-width: 1240px) { .desk { display: none !important; } .desk-l { display: none !important; } .mob { display: block; } }
  @media (max-width: 480px) { .book { padding: 8px 12px; font-size: .8rem; } .bar { gap: 10px; } }
  @media (max-width: 380px) { .book { white-space: normal; text-align: center; line-height: 1.15; max-width: 150px; } }
</style>
