---
import Base from '../layouts/Base.astro';
import { SITE } from '../data/site';
import { t, type Lang } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const P = t(lang).privacy;
---
<Base title={P.title} description={P.lead} lang={lang}>
  <section class="phead cream"><div class="wrap"><h1>{P.h1}</h1><p class="lead">{P.lead}</p></div></section>
  <section><div class="wrap prose">
    {P.items.map(([h, p]) => <div class="it"><h2>{h}</h2><p>{p}</p></div>)}
    <p><a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
    <p class="muted" style="margin-top:24px"><span class="ph">placeholder</span> {P.review}</p>
  </div></section>
</Base>
<style>.it { margin-bottom: 28px; } .it h2 { font-size: 1.35rem; margin-bottom: 6px; }</style>
