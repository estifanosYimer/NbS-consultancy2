---
import Base from '../layouts/Base.astro';
import FilmCard from '../components/FilmCard.astro';
import { famsFor, solsFor } from '../i18n/data';
import { fmt, lp, t, type Lang } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const T = t(lang); const S = T.sol;
const L = (p: string) => lp(lang, p);
const sols = await solsFor(lang);
const fams = famsFor(lang);
const nbs = sols.filter((s) => !s.supporting);
const nFam = fams.filter((f) => !f.support).length;
const filmFams = fams.filter((f) => f.film);
const challenges = ['floods', 'drought', 'groundwater', 'quality', 'erosion', 'heat', 'biodiversity', 'carbon'] as const;
---
<Base title={fmt(S.title, { n: nbs.length })} description={fmt(S.desc, { n: nbs.length })} lang={lang}>
  <section class="phead cream">
    <div class="wrap">
      <p class="eyebrow">{fmt(S.eyebrow, { n: nbs.length, f: nFam })}</p>
      <h1>{S.h1}</h1>
      <p class="lead">{S.lead}</p>
      <nav class="jump" aria-label={S.family}>
        {fams.map((f) => <a href={`#${f.id}`}>{f.name}</a>)}
      </nav>
    </div>
  </section>

  <section class="tools-bar-wrap">
    <div class="wrap">
      <form class="filters" id="sol-filter" role="search" onsubmit="return false">
        <label class="search"><span class="sr">{S.search}</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
          <input type="search" name="q" placeholder={S.search} autocomplete="off" />
        </label>
        <label><span class="sr">{S.challenge}</span>
          <select name="c"><option value="">{S.allC}</option>{challenges.map((c) => <option value={c}>{T.benefits[c]}</option>)}</select>
        </label>
        <label><span class="sr">{S.landscape}</span>
          <select name="l"><option value="">{S.allL}</option>{Object.entries(T.landscapes).map(([k, v]) => <option value={k}>{v}</option>)}</select>
        </label>
        <output id="sol-count" aria-live="polite" data-tpl={S.shown}>{fmt(S.shown, { n: sols.length })}</output>
      </form>

      {fams.map((f) => {
        const list = sols.filter((s) => s.family === f.id);
        return (
          <div class="fam" id={f.id} data-fam>
            <div class="fhead">
              <h2>{f.name} <span class="cnt">{list.length}</span></h2>
              <p class="muted">{f.intro}</p>
              {f.support && <p class="note small">{S.support}</p>}
            </div>
            <div class="grid g4 wide">
              {list.map((s) => (
                <a class="card sol" href={L(`/solutions/${s.id}/`)} data-b={s.benefits.join(' ')} data-l={s.landscapes.join(' ')} data-t={`${s.title} ${s.summary}`.toLowerCase()}>
                  <h3>{s.title}</h3>
                  <p>{s.summary}</p>
                  <span class="tags">{s.benefits.slice(0, 3).map((b) => <span class="tag">{(T.benefits as any)[b]}</span>)}</span>
                </a>
              ))}
            </div>
          </div>
        );
      })}
      <p class="none" id="sol-none" hidden>{S.none}</p>
    </div>
  </section>

  <section class="cream">
    <div class="wrap">
      <div class="head"><h2>{S.films}</h2></div>
      <div class="grid g5">
        {filmFams.map((f) => <FilmCard film={f.film!} title={f.name} />)}
      </div>
    </div>
  </section>
</Base>
<script>
  const form = document.getElementById('sol-filter') as HTMLFormElement | null;
  const out = document.getElementById('sol-count');
  const none = document.getElementById('sol-none');
  if (form && out && none) {
    const cards = [...document.querySelectorAll<HTMLElement>('a.sol')];
    const fams = [...document.querySelectorAll<HTMLElement>('[data-fam]')];
    const run = () => {
      const fd = new FormData(form);
      const q = String(fd.get('q') || '').trim().toLowerCase(), c = String(fd.get('c') || ''), l = String(fd.get('l') || '');
      let n = 0;
      cards.forEach((el) => {
        const ok = (!q || (el.dataset.t || '').includes(q)) && (!c || (el.dataset.b || '').split(' ').includes(c)) && (!l || (el.dataset.l || '').split(' ').includes(l));
        el.hidden = !ok; if (ok) n++;
      });
      fams.forEach((f) => { f.hidden = !f.querySelector('a.sol:not([hidden])'); });
      out.textContent = (out.dataset.tpl || '{n}').replace('{n}', String(n));
      none.hidden = n > 0;
    };
    form.addEventListener('input', run);
    form.addEventListener('change', run);
    const p = new URLSearchParams(location.search);
    (['q', 'c', 'l'] as const).forEach((k) => { const v = p.get(k); const el = form.elements.namedItem(k) as HTMLInputElement | null; if (v && el) el.value = v; });
    run();
  }
</script>
<style>
  .jump { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 26px; }
  .jump a { font-weight: 600; font-size: .9rem; text-decoration: none; color: var(--forest); background: #fff; border: 1px solid var(--line); border-radius: 100px; padding: 7px 14px; }
  .jump a:hover { border-color: var(--leaf); }
  .tools-bar-wrap { padding-top: 0; }
  .filters { position: sticky; top: 68px; z-index: 20; display: flex; flex-wrap: wrap; gap: 10px; align-items: center; background: rgba(252, 250, 245, .96); backdrop-filter: blur(8px); padding: 16px 0; border-bottom: 1px solid var(--line); margin-bottom: 28px; }
  .search { flex: 1 1 320px; display: flex; align-items: center; gap: 8px; background: #fff; border: 1px solid var(--line); border-radius: 100px; padding: 0 16px; color: var(--ink-soft); }
  .search input { border: 0; outline: 0; font: inherit; padding: 11px 0; width: 100%; background: transparent; color: var(--ink); }
  .search:focus-within { outline: 3px solid var(--gold); outline-offset: 2px; }
  select { font: 600 .95rem var(--sans); padding: 11px 16px; border: 1px solid var(--line); border-radius: 100px; background: #fff; color: var(--ink); }
  output { font: 500 .8rem var(--mono); color: var(--ink-soft); margin-left: auto; }
  .fam { padding: 28px 0 36px; scroll-margin-top: 150px; }
  .fhead { max-width: 820px; margin-bottom: 18px; }
  .fhead h2 { font-size: clamp(1.5rem, 2.6vw, 2rem); display: flex; align-items: baseline; gap: 12px; }
  .cnt { font: 500 .8rem var(--mono); color: var(--gold-text); }
  .small { margin-top: 10px; font-size: .92rem; }
  .sol h3 { font-size: 1.12rem; margin-bottom: 6px; }
  .sol p { font-size: .93rem; color: var(--ink-soft); margin-bottom: 12px; }
  .tags { display: flex; flex-wrap: wrap; gap: 6px; }
  .none { padding: 40px 0; font-size: 1.1rem; }
  [hidden] { display: none !important; }
</style>
