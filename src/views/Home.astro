---
import Base from '../layouts/Base.astro';
import HeroArt from '../components/HeroArt.astro';
import Finder from '../components/Finder.astro';
import FilmCard from '../components/FilmCard.astro';
import { bookHref } from '../data/site';
import { famsFor, solsFor } from '../i18n/data';
import { fmt, lp, t, type Lang } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const T = t(lang); const H = T.home;
const L = (p: string) => lp(lang, p);
const all = await solsFor(lang);
const nbs = all.filter((s) => !s.supporting);
const families = famsFor(lang).filter((f) => !f.support);
const count = (f: string) => all.filter((s) => s.family === f).length;
---
<Base title={H.title} description={H.desc} lang={lang}>
  <!-- 1. WHAT WE ARE -->
  <section class="hero cream">
    <div class="wrap hero-grid">
      <div>
        <p class="eyebrow">{H.eyebrow}</p>
        <h1>{H.h1a} <em>{H.h1b}</em></h1>
        <p class="lead">{H.lead}</p>
        <div class="cta">
          <a class="btn btn-primary" href="#find">{T.btn.find} →</a>
          <a class="btn btn-ghost" href={bookHref(lang)} data-track="book-call">{T.btn.book}</a>
          <button class="btn btn-ghost" type="button" data-film="journey" data-title={H.proofCap}>
            <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 4v16l13-8z"/></svg>{T.btn.watch}
          </button>
        </div>
        <p class="who"><span>{H.forWho}:</span>
          {Object.entries(T.audiences).map(([k, a]) => <a href={L(`/for/${k}/`)}>{a.name}</a>)}
        </p>
      </div>
      <HeroArt />
    </div>
  </section>

  <!-- 2. WHAT WE DO -->
  <section>
    <div class="wrap">
      <div class="head">
        <p class="eyebrow">{H.howEyebrow}</p>
        <h2>{H.howH2a} <em>{H.howH2b}</em></h2>
        <p class="lead">{H.howLead}{lang !== 'en' && <> <span class="muted">{H.note}</span></>}</p>
      </div>
      <div class="grid g4">
        {T.stages.map((s) => <FilmCard film={s.film} title={s.name} eyebrow={s.n} line={s.line} />)}
      </div>
      <p class="more"><a href={L('/services/')}>{H.howMore}</a></p>
    </div>
  </section>

  <!-- 3. WHAT WE WORK WITH -->
  <section class="cream">
    <div class="wrap">
      <div class="head">
        <p class="eyebrow">{fmt(H.famEyebrow, { n: nbs.length })}</p>
        <h2>{H.famH2a} <em>{H.famH2b}</em></h2>
        <p class="lead">{H.famLead}</p>
      </div>
      <div class="grid g3 fams">
        {families.map((f) => (
          <a class="card fam" href={L(`/solutions/#${f.id}`)}>
            <h3>{f.name}</h3><p>{f.intro}</p>
            <span class="cnt">{fmt(H.famCount, { n: count(f.id) })} →</span>
          </a>
        ))}
      </div>
      <p class="more"><a class="btn btn-primary" href={L('/solutions/')}>{fmt(H.famAll, { n: nbs.length })}</a></p>
    </div>
  </section>

  <!-- 4. FIND YOUR SOLUTION -->
  <section id="find">
    <div class="wrap">
      <div class="head">
        <p class="eyebrow">{H.findEyebrow}</p>
        <h2>{H.findH2a} <em>{H.findH2b}</em></h2>
        <p class="lead">{H.findLead}</p>
      </div>
      <Finder lang={lang} />
    </div>
  </section>

  <!-- 5. QUALITY + CALL -->
  <section class="cream">
    <div class="wrap duo">
      <div class="iucn">
        <p class="eyebrow">{H.iucnEyebrow}</p>
        <h2>{H.iucnH2a} <em>{H.iucnH2b}</em></h2>
        <p>{H.iucnLead}</p>
        <div class="sep"><Fragment set:html={H.iucnSep} /> <a href={L('/services/#standards')}>{H.iucnLink}</a></div>
      </div>
      <div class="band">
        <p class="eyebrow light">{H.ctaEyebrow}</p>
        <h2>{H.ctaH2a} <em>{H.ctaH2b}</em></h2>
        <p>{H.ctaText}</p>
        <div class="cta">
          <a class="btn btn-gold" href={bookHref(lang)} data-track="book-call">{T.btn.book}</a>
          <a class="btn ghost-light" href={L('/contact/')}>{T.btn.write}</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { padding: clamp(48px, 7vw, 88px) 0; }
  .hero-grid { display: grid; grid-template-columns: 1.15fr .85fr; gap: clamp(32px, 5vw, 80px); align-items: center; }
  .hero h1 { margin: 16px 0 18px; }
  .cta { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 26px; }
  .who { display: flex; flex-wrap: wrap; gap: 6px 14px; margin-top: 28px; font-size: .93rem; color: var(--ink-soft); }
  .who span { font-weight: 700; color: var(--forest); }
  .who a { color: var(--ink-soft); text-decoration: underline; text-decoration-color: var(--mist); text-underline-offset: 3px; }
  .who a:hover { color: var(--forest); text-decoration-color: var(--leaf); }
  .more { margin-top: 28px; }
  .more a:not(.btn) { font-weight: 700; }
  .fam { display: grid; gap: 6px; align-content: start; border-left: 4px solid var(--sage); }
  .fam:hover { border-left-color: var(--leaf); }
  .fam p { font-size: .94rem; color: var(--ink-soft); }
  .cnt { font: 600 .82rem var(--sans); color: var(--leaf); margin-top: 4px; }
  .duo { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(24px, 4vw, 48px); align-items: stretch; }
  .iucn h2 { margin: 12px 0 14px; font-size: clamp(1.6rem, 2.8vw, 2.2rem); }
  .iucn p { color: var(--ink-soft); }
  .sep { margin-top: 18px; border-left: 3px solid var(--leaf); background: #fff; padding: 14px 18px; border-radius: 0 12px 12px 0; font-size: .95rem; }
  .band { background: var(--forest); color: #e7efe9; border-radius: var(--r-lg); padding: clamp(28px, 4vw, 48px); display: flex; flex-direction: column; justify-content: center; }
  .band h2 { color: #fff; margin: 10px 0 12px; font-size: clamp(1.6rem, 2.8vw, 2.2rem); } .band h2 em { color: var(--gold-soft); }
  .light { color: var(--gold-soft); }
  .ghost-light { border-color: rgba(255, 255, 255, .4); color: #fff; }
  .ghost-light:hover { background: rgba(255, 255, 255, .1); }
  @media (max-width: 1000px) { .hero-grid, .duo { grid-template-columns: 1fr; } }
</style>
