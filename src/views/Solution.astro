---
import Base from '../layouts/Base.astro';
import FilmCard from '../components/FilmCard.astro';
import { bookHref } from '../data/site';
import { famsFor, solsFor, toolsFor } from '../i18n/data';
import { fmt, lp, t, type Lang } from '../i18n/ui';
interface Props { lang: Lang; id: string }
const { lang, id } = Astro.props;
const T = t(lang); const S = T.sol;
const L = (p: string) => lp(lang, p);
const sols = await solsFor(lang);
const s = sols.find((x) => x.id === id)!;
const fam = famsFor(lang).find((f) => f.id === s.family)!;
const tools = toolsFor(lang).filter((x) => s.tools.includes(x.id));
const related = sols.filter((x) => x.family === s.family && x.id !== s.id).slice(0, 4);
const more = related.length < 4 ? sols.filter((x) => x.family !== s.family && !x.supporting && x.benefits[0] === s.benefits[0]).slice(0, 4 - related.length) : [];
---
<Base title={fmt(S.detailTitle, { t: s.title })} description={`${s.summary} ${fam.intro}`} lang={lang}>
  <section class="phead cream">
    <div class="wrap">
      <p class="crumbs"><a href={L('/solutions/')}>{T.nav.solutions}</a> / <a href={L(`/solutions/#${fam.id}`)}>{fam.name}</a></p>
      <p class="eyebrow">{fam.name}</p>
      <h1>{s.title}</h1>
      <p class="lead">{s.summary}</p>
      {s.supporting && <p class="note" style="margin-top:18px;max-width:72ch">{S.support}</p>}
      <div class="cta-row">
        <a class="btn btn-primary" href={L(`/contact/?topic=measure&measure=${encodeURIComponent(s.title)}#form`)}>{S.talk} →</a>
        <a class="btn btn-ghost" href={bookHref(lang)} data-track="book-call">{T.btn.book}</a>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap two">
      <div class="facts">
        <div>
          <h2 class="h">{S.helps}</h2>
          <div class="chips">{s.benefits.map((b) => <a class="chip" href={L(`/solutions/?c=${b}`)}>{(T.benefits as any)[b]}</a>)}</div>
        </div>
        <div>
          <h2 class="h">{S.fits}</h2>
          <div class="chips">{s.landscapes.map((l) => <a class="chip" href={L(`/solutions/?l=${l}`)}>{(T.landscapes as any)[l]}</a>)}</div>
        </div>
        <div>
          <h2 class="h">{S.family}</h2>
          <p class="muted">{fam.intro}</p>
        </div>
        <div class="note"><b>IUCN Global Standard.</b> {S.iucn}</div>
      </div>
      <div>
        {fam.film && <div class="filmbox"><h2 class="h">{S.watch}</h2><FilmCard film={fam.film} title={fam.name} /></div>}
        {tools.length > 0 && (
          <div>
            <h2 class="h">{S.tools}</h2>
            <div class="tl">
              {tools.map((x) => <a class="card tcard" href={L(`/tools/${x.id}/`)}><span class="q">{x.q}</span><b>{x.n}</b></a>)}
            </div>
          </div>
        )}
      </div>
    </div>
  </section>

  {related.length + more.length > 0 && (
    <section class="cream">
      <div class="wrap">
        <div class="head"><h2>{S.related}</h2></div>
        <div class="grid g4">
          {[...related, ...more].map((r) => <a class="card rel" href={L(`/solutions/${r.id}/`)}><h3>{r.title}</h3><p>{r.summary}</p></a>)}
        </div>
        <p style="margin-top:28px"><a href={L('/solutions/')} style="font-weight:700">{S.back}</a></p>
      </div>
    </section>
  )}
</Base>
<style>
  .two { display: grid; grid-template-columns: 1.1fr 1fr; gap: clamp(32px, 5vw, 72px); align-items: start; }
  .facts { display: grid; gap: 28px; }
  .h { font: 500 .78rem var(--mono); letter-spacing: .16em; text-transform: uppercase; color: var(--gold-text); margin-bottom: 12px; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .chip { text-decoration: none; font-weight: 600; font-size: .95rem; color: var(--forest); background: var(--sage-tint); border-radius: 100px; padding: 8px 14px; }
  .chip:hover { background: var(--mist); }
  .filmbox { margin-bottom: 28px; }
  .tl { display: grid; gap: 10px; }
  .tcard { padding: 16px 20px; display: grid; gap: 2px; }
  .tcard b { font-family: var(--serif); font-size: 1.1rem; }
  .q { font: 500 .72rem var(--mono); letter-spacing: .08em; text-transform: uppercase; color: var(--gold-text); }
  .rel h3 { font-size: 1.1rem; margin-bottom: 6px; } .rel p { font-size: .93rem; color: var(--ink-soft); }
  @media (max-width: 900px) { .two { grid-template-columns: 1fr; } }
</style>
