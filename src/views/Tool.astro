---
import Base from '../layouts/Base.astro';
import FilmCard from '../components/FilmCard.astro';
import { Image } from 'astro:assets';
import shot from '../assets/suitability-gui.jpg';
import { bookHref } from '../data/site';
import { solsFor, toolsFor } from '../i18n/data';
import { fmt, lp, t, type Lang } from '../i18n/ui';
interface Props { lang: Lang; id: string }
const { lang, id } = Astro.props;
const T = t(lang); const X = T.tools;
const L = (p: string) => lp(lang, p);
const all = toolsFor(lang);
const x = all.find((y) => y.id === id)!;
const idx = all.indexOf(x);
const next = all[(idx + 1) % all.length];
const sols = (await solsFor(lang)).filter((s) => s.tools.includes(id) && !s.supporting);
---
<Base title={fmt(X.detailTitle, { t: x.n })} description={`${x.q} ${x.plain}`} lang={lang}>
  <section class="phead cream">
    <div class="wrap hero">
      <div>
        <p class="crumbs"><a href={L('/tools/')}>{T.nav.tools}</a></p>
        <p class="eyebrow">{x.q}</p>
        <h1>{x.n}</h1>
        <p><span class={`status ${x.statusClass}`}>{x.status}</span></p>
        <p class="lead" style="margin-top:16px">{x.plain}</p>
        <div class="cta-row">
          <a class="btn btn-primary" href={L(`/contact/?topic=demo&tool=${encodeURIComponent(x.n)}#form`)}>{X.demo} →</a>
          <a class="btn btn-ghost" href={bookHref(lang)} data-track="book-call">{T.btn.book}</a>
        </div>
      </div>
      <div>
        {x.image && <figure class="shot"><Image src={shot} alt={`${x.n}: ${X.shot}`} widths={[640, 1100]} sizes="(max-width: 900px) 100vw, 50vw" /><figcaption>{X.shot}</figcaption></figure>}
        {!x.image && x.video && <FilmCard film={x.video} title={x.n} />}
        {x.image && x.video && <div style="margin-top:16px"><FilmCard film={x.video} title={T.stages[0].name} line={T.stages[0].line} /></div>}
      </div>
    </div>
  </section>
  <section>
    <div class="wrap">
      <div class="grid g3 blocks">
        <div class="card"><h2 class="h">{X.bring}</h2><ul class="list">{x.inputs.map((i) => <li>{i}</li>)}</ul></div>
        <div class="card"><h2 class="h">{X.get}</h2><ul class="list">{x.outputs.map((i) => <li>{i}</li>)}</ul></div>
        <div class="card"><h2 class="h">{X.session}</h2><ol class="steps">{x.session.map((i) => <li>{i}</li>)}</ol></div>
      </div>
      <div class="grid g2 low">
        <div><h2 class="h">{X.who}</h2><p>{x.w}</p></div>
        <details class="eng"><summary>{X.eng}{lang !== 'en' && <span lang="en"> (English)</span>}</summary><p lang="en">{x.tech}</p></details>
      </div>
      {id === 'studio' && <p class="note" style="margin-top:28px;max-width:90ch" set:html={X.studioNote} />}
    </div>
  </section>
  {sols.length > 0 && (
    <section class="cream">
      <div class="wrap">
        <div class="head"><h2>{X.sols}</h2></div>
        <div class="chips">{sols.map((s) => <a class="chip" href={L(`/solutions/${s.id}/`)}>{s.title}</a>)}</div>
        <p class="navl"><a href={L('/tools/')}>{X.allTools}</a><a href={L(`/tools/${next.id}/`)}>{next.n} →</a></p>
      </div>
    </section>
  )}
  {sols.length === 0 && <section class="cream"><div class="wrap"><p class="navl"><a href={L('/tools/')}>{X.allTools}</a><a href={L(`/tools/${next.id}/`)}>{next.n} →</a></p></div></section>}
</Base>
<style>
  .hero { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px, 5vw, 72px); align-items: center; }
  .shot { background: #fff; border: 1px solid var(--line); border-radius: var(--r); overflow: hidden; }
  .shot :global(img) { width: 100%; height: auto; }
  .shot figcaption { padding: 10px 14px; font-size: .85rem; color: var(--ink-soft); }
  .h { font: 500 .78rem var(--mono); letter-spacing: .16em; text-transform: uppercase; color: var(--gold-text); margin-bottom: 12px; }
  .steps { counter-reset: s; list-style: none; display: grid; gap: 8px; }
  .steps li { counter-increment: s; position: relative; padding-left: 34px; }
  .steps li::before { content: counter(s); position: absolute; left: 0; top: 0; width: 24px; height: 24px; border-radius: 50%; background: var(--forest); color: #fff; font: 600 .76rem var(--mono); display: grid; place-items: center; }
  .low { margin-top: 32px; gap: 32px; }
  .eng { border: 1px solid var(--line); border-radius: var(--r); padding: 14px 18px; background: var(--paper); }
  .eng summary { cursor: pointer; font-weight: 700; color: var(--forest); }
  .eng p { margin-top: 10px; font-size: .95rem; color: var(--ink-soft); }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .chip { text-decoration: none; font-weight: 600; font-size: .93rem; color: var(--forest); background: #fff; border: 1px solid var(--line); border-radius: 100px; padding: 8px 14px; }
  .chip:hover { border-color: var(--leaf); }
  .navl { display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin-top: 32px; font-weight: 700; }
  @media (max-width: 900px) { .hero { grid-template-columns: 1fr; } }
</style>
