---
import Base from '../layouts/Base.astro';
import { bookHref } from '../data/site';
import { t, type Lang } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const T = t(lang); const A = T.about;
const initials = (n: string) => n.replace(/^Prof\.\s*/, '').split(/\s+/).map((w) => w[0]).slice(0, 2).join('');
---
<Base title={A.title} description={A.desc} lang={lang}>
  <section class="phead cream"><div class="wrap">
    <p class="eyebrow">{A.eyebrow}</p><h1>{A.h1}</h1><p class="lead">{A.lead}</p>
  </div></section>
  <section><div class="wrap">
    <div class="head"><h2>{A.approachH}</h2></div>
    <div class="grid g4 wide">{A.approach.map(([h, p]) => <div class="card"><h3>{h}</h3><p class="muted" style="margin-top:6px">{p}</p></div>)}</div>
  </div></section>
  <section class="cream"><div class="wrap">
    <div class="head"><h2>{A.teamH}</h2></div>
    <div class="grid g4 wide">
      {A.team.map(([n, r, b]) => (
        <div class="card person"><span class="av" aria-hidden="true">{initials(n)}</span><h3>{n}</h3><p class="role">{r}</p><p class="muted">{b}</p></div>
      ))}
    </div>
  </div></section>
  <section><div class="wrap">
    <div class="head"><h2>{A.pubH}</h2><p class="muted"><span class="ph">placeholder</span> {A.pubP}</p></div>
    <div class="cta-row"><a class="btn btn-primary" href={bookHref(lang)} data-track="book-call">{T.btn.book}</a></div>
  </div></section>
</Base>
<style>
  .person { display: grid; gap: 4px; align-content: start; }
  .av { width: 56px; height: 56px; border-radius: 50%; background: var(--forest); color: #fff; display: grid; place-items: center; font: 600 1.1rem var(--serif); margin-bottom: 10px; }
  .role { font: 500 .74rem var(--mono); letter-spacing: .1em; text-transform: uppercase; color: var(--gold-text); }
  .person .muted { font-size: .94rem; margin-top: 6px; }
</style>
